APP_NAME="酒丸算盤"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://insights.sakemaru.test
APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja
APP_FAKER_LOCALE=ja_JP
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Default DB (ins_ prefix for insights tables)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sakemaru_hana_prod
DB_USERNAME=root
DB_PASSWORD=
DB_TABLE_PREFIX='ins_'

# Sakemaru DB (shared master/auth)
DB_HOST_SAKEMARU=127.0.0.1
DB_PORT_SAKEMARU=3306
DB_DATABASE_SAKEMARU=sakemaru_hana_prod
DB_USERNAME_SAKEMARU=root
DB_PASSWORD_SAKEMARU=

# Session (shared with WMS via .sakemaru.test domain)
SESSION_DRIVER=database
SESSION_DOMAIN=.sakemaru.test
SESSION_COOKIE=sakemaru_session
SESSION_LIFETIME=3600
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_CONNECTION=sakemaru

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=ins_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
