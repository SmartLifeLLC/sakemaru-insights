APP_NAME="酒丸算盤"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://insights.sakemaru.test
APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja
APP_FAKER_LOCALE=ja_JP
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Default DB (ins_ prefix for insights tables)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sakemaru_hana_prod
DB_USERNAME=root
DB_PASSWORD=
DB_TABLE_PREFIX='ins_'

# Sakemaru DB (shared master/auth)
DB_HOST_SAKEMARU=127.0.0.1
DB_PORT_SAKEMARU=3306
DB_DATABASE_SAKEMARU=sakemaru_hana_prod
DB_USERNAME_SAKEMARU=root
DB_PASSWORD_SAKEMARU=

# Session (shared with WMS via .sakemaru.test domain)
SESSION_DRIVER=database
SESSION_DOMAIN=.sakemaru.test
SESSION_COOKIE=sakemaru_session
SESSION_LIFETIME=3600
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_CONNECTION=sakemaru

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=ins_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---- 運用監視（config/monitoring.php）----
MONITOR_ENABLED=true
MONITOR_DEPLOYMENT_ID=hana-local
MONITOR_CLIENT_NAME=華
MONITOR_ENVIRONMENT=local
MONITOR_NODE_CODE=local
MONITOR_CHECK_OWNER_NODE=local
# 業務DBへの SELECT 専用接続（未設定時は業務照合チェックを実行しない）
MONITOR_SOURCE_DATABASE=
MONITOR_SOURCE_USERNAME=
MONITOR_SOURCE_PASSWORD=
# Slack エラーチャンネル（URL は DB・画面・ログに保存しない）
MONITOR_SLACK_ERROR_WEBHOOK=
MONITOR_SLACK_ERROR_CHANNEL_NAME=#sakemaru-errors
MONITOR_SLACK_ERROR_MENTION=
# 代替通知先・ホスト外死活監視（本番移行の完了条件）
MONITOR_FALLBACK_CONTACT=
MONITOR_EXTERNAL_HEARTBEAT_URL=
# 権限（email または code をカンマ区切り。* で全員）
MONITOR_RESPONDERS=*
MONITOR_MANAGERS=
MONITOR_DELIVERY_ADMINS=
# 収集器の署名鍵（config/monitoring.php collectors の secret_env と対応）
# MONITOR_COLLECTOR_SECRET_TRADE_WEB1=

# --- 運用監視 v2（/monitor パネル・資源・プローブ・メール・電話）---
# ノード（各サーバー）。初回の資源送信で自動登録される
MONITOR_NODE_ROLE=web
MONITOR_NODE_DISPLAY_NAME=
# このサーバーで必ず動いているべきプロセス（apache,php-fpm,supervisor）。未設定なら役割の既定（web: 3 つ全部 / batch: php-fpm,supervisor）
MONITOR_NODE_PROCESSES=
# 別サーバーから資源データを送る場合の共通鍵（同じ顧客の全ノードで共有。値はここに書かない）
MONITOR_METRICS_SECRET=
MONITOR_METRICS_DIR=
# HTTP プローブの許可ホスト（顧客の自サービスのみ。先頭ドットでサブドメイン許可）
MONITOR_PROBE_ALLOWED_HOSTS=
# メール（宛先。SMTP は通知設定画面で登録。画面 > MAIL_*）
MONITOR_MAIL_ENABLED=true
MONITOR_MAIL_TO=admin@sakemaru.ai
# 電話（Twilio。認証情報は通知設定画面で登録。画面 > TWILIO_*）
MONITOR_PHONE_ENABLED=true
MONITOR_PHONE_ALLOW_ENV=production
MONITOR_PUBLIC_BASE_URL=
